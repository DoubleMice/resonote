<div class="search-shell relative mb-8 max-w-3xl" id="search-root" role="search">
  <label for="search-input" class="sr-only">搜索节目标题、嘉宾、来源或标签</label>
  <input
    type="search"
    id="search-input"
    role="combobox"
    aria-autocomplete="list"
    aria-expanded="false"
    aria-controls="search-results"
    aria-haspopup="listbox"
    placeholder="在声笺中寻找节目、嘉宾、来源或标签"
    class="search-input w-full pl-12 pr-24 text-sm"
    autocomplete="off"
    spellcheck="false"
  />
  <svg class="search-icon absolute left-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
  </svg>
  <kbd class="search-shortcut" aria-hidden="true">⌘ K</kbd>
  <button id="search-clear" class="search-clear hidden" type="button" aria-label="清空搜索">
    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 6 8 8m0-8-8 8" /></svg>
  </button>

  <div
    id="search-results"
    role="listbox"
    aria-label="搜索结果"
    class="search-results absolute left-0 right-0 top-full mt-2 hidden z-20"
  ></div>
</div>

<style>
  .search-input {
    min-height: 56px;
    appearance: none;
    border: 1px solid rgba(var(--resonote-ink-rgb), 0.12);
    border-left: 3px solid rgba(var(--resonote-seal-rgb), 0.72);
    border-radius: 4px 17px 17px 4px;
    color: var(--resonote-ink);
    background: rgba(251, 248, 241, 0.92);
    box-shadow: 0 10px 30px rgba(var(--resonote-ink-rgb), 0.05);
    transition: border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }
  .search-input::-webkit-search-cancel-button { display: none; }
  .search-input::placeholder { color: #7d8883; }
  .search-input:focus {
    border-color: rgba(var(--resonote-accent-rgb), 0.5);
    border-left-color: var(--resonote-amber);
    outline: 0;
    background: #fffdf8;
    box-shadow: 0 0 0 4px rgba(var(--resonote-accent-rgb), 0.09), 0 14px 34px rgba(var(--resonote-ink-rgb), 0.07);
  }
  .search-icon { width: 18px; height: 18px; color: #6f7d77; pointer-events: none; }
  .search-shortcut {
    position: absolute;
    top: 50%;
    right: 14px;
    min-width: 43px;
    padding: 3px 6px;
    border: 1px solid rgba(var(--resonote-ink-rgb), 0.12);
    border-radius: 7px;
    color: #727e79;
    background: #f0ebe1;
    box-shadow: 0 1px 0 rgba(var(--resonote-ink-rgb), 0.08);
    font-family: inherit;
    font-size: 0.65rem;
    line-height: 1.25;
    text-align: center;
    transform: translateY(-50%);
  }
  .search-shell.has-query .search-shortcut { display: none; }
  .search-clear {
    position: absolute;
    top: 50%;
    right: 8px;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 12px;
    color: #64716c;
    background: transparent;
    cursor: pointer;
    transform: translateY(-50%);
  }
  .search-clear:not(.hidden) { display: inline-flex; }
  .search-clear:hover { color: var(--resonote-ink); background: rgba(var(--resonote-ink-rgb), 0.06); }
  .search-clear svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  .search-results {
    max-height: min(470px, 62vh);
    overflow-y: auto;
    padding: 7px;
    border: 1px solid rgba(var(--resonote-ink-rgb), 0.12);
    border-radius: 4px 17px 17px 4px;
    background: rgba(255, 253, 248, 0.98);
    box-shadow: 0 24px 60px rgba(var(--resonote-ink-rgb), 0.15);
    backdrop-filter: blur(16px);
  }
  :global(.search-result) {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 8px;
    border-radius: 11px;
    color: var(--resonote-ink);
    text-decoration: none;
  }
  :global(.search-result:hover),
  :global(.search-result[aria-selected="true"]) { background: #eef1eb; }
  :global(.search-result-thumb) { width: 72px; height: 44px; border-radius: 8px; object-fit: cover; background: #ece9e2; }
  :global(.search-result-fallback) { display: grid; place-items: center; color: #7f8b85; font-size: 0.62rem; letter-spacing: 0.08em; }
  :global(.search-result-title) { display: block; overflow: hidden; color: var(--resonote-ink); font-size: 0.86rem; font-weight: 720; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
  :global(.search-result-meta) { display: block; overflow: hidden; margin-top: 4px; color: #6f7d77; font-size: 0.7rem; text-overflow: ellipsis; white-space: nowrap; }
  :global(.search-result-dot) { display: inline-block; width: 7px; height: 7px; margin-right: 5px; border-radius: 50%; }
  :global(.search-result-format) { padding: 4px 7px; border-radius: 999px; color: var(--resonote-blue); background: rgba(var(--resonote-accent-rgb), 0.09); font-size: 0.62rem; font-weight: 750; }
  :global(.search-empty) { padding: 24px 18px; color: #69767d; font-size: 0.82rem; line-height: 1.7; text-align: center; }
  :global(.search-empty strong) { display: block; margin-bottom: 2px; color: var(--resonote-ink); }
  @media (max-width: 520px) {
    .search-shortcut { display: none; }
    .search-input { min-height: 54px; padding-right: 52px; }
    :global(.search-result) { grid-template-columns: 58px minmax(0, 1fr); }
    :global(.search-result-thumb) { width: 58px; height: 38px; }
    :global(.search-result-format) { display: none; }
  }
</style>

<script>
  import { loadLibraryRows } from '../lib/library-loader'
  (() => {
    const root = document.getElementById('search-root')
    const input = document.getElementById('search-input')
    const results = document.getElementById('search-results')
    const clear = document.getElementById('search-clear')
    if (!root || !(input instanceof HTMLInputElement) || !results || !clear) return

    // Reuse the server-rendered rows, loading the rest of the archive on first use.
    const readIndex = () => [...document.querySelectorAll<HTMLElement>('[data-library-item]')].map(row => {
      const link = row.querySelector<HTMLAnchorElement>('.row-title a')!
      const source = row.querySelector<HTMLElement>('.row-source')!
      const slides = row.dataset.hasSlides === 'true'
      const article = row.dataset.hasArticle === 'true'
      return {
        target: link.href,
        externalOnly: !slides && !article,
        format: slides ? '视觉笔记' : article ? '文章' : '原文',
        title: link.textContent || '',
        guest: row.dataset.searchGuest || '',
        source: source.textContent?.trim() || '',
        source_color: source.style.getPropertyValue('--source-color') || '#525252',
        thumbnail: row.querySelector('img')?.getAttribute('src') || '',
        _hay: row.dataset.search || '',
      }
    })
    let index: ReturnType<typeof readIndex> | undefined
    let activeIndex = -1
    let rendered = []

    const escapeHtml = (value) => String(value).replace(/[&<>"']/g, character => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    })[character])

    const setOpen = (open) => {
      results.classList.toggle('hidden', !open)
      input.setAttribute('aria-expanded', String(open))
      if (!open) {
        activeIndex = -1
        input.removeAttribute('aria-activedescendant')
      }
    }

    const setActive = (nextIndex) => {
      const options = [...results.querySelectorAll('[role="option"]')]
      if (!options.length) return
      activeIndex = (nextIndex + options.length) % options.length
      options.forEach((option, index) => option.setAttribute('aria-selected', String(index === activeIndex)))
      const active = options[activeIndex]
      input.setAttribute('aria-activedescendant', active.id)
      active.scrollIntoView({ block: 'nearest' })
    }

    const render = (matches) => {
      rendered = matches.slice(0, 8)
      activeIndex = -1
      input.removeAttribute('aria-activedescendant')

      if (!rendered.length) {
        results.innerHTML = '<div class="search-empty" role="status"><strong>没有找到匹配内容</strong>试试节目名、嘉宾、来源或更短的关键词</div>'
        return
      }

      results.innerHTML = rendered.map((item, index) => `
        <a id="search-option-${index}" role="option" aria-selected="false" tabindex="-1"
          href="${escapeHtml(item.target)}" ${item.externalOnly ? 'target="_blank" rel="noopener"' : ''}
          class="search-result">
          ${item.thumbnail
            ? `<img src="${escapeHtml(item.thumbnail)}" alt="" class="search-result-thumb" loading="lazy" />`
            : '<div class="search-result-thumb search-result-fallback" aria-hidden="true">声笺</div>'}
          <span class="min-w-0">
            <span class="search-result-title">${escapeHtml(item.title)}</span>
            <span class="search-result-meta"><i class="search-result-dot" style="background:${escapeHtml(item.source_color)}"></i>${escapeHtml(item.source)}${item.guest ? ` · ${escapeHtml(item.guest)}` : ''}</span>
          </span>
          <span class="search-result-format">${escapeHtml(item.format)}</span>
        </a>
      `).join('')
    }

    let searchRevision = 0
    const search = async (rawQuery) => {
      const revision = ++searchRevision
      const query = rawQuery.trim().toLowerCase()
      root.classList.toggle('has-query', Boolean(query))
      clear.classList.toggle('hidden', !query)
      if (!query) {
        setOpen(false)
        return
      }

      if (document.getElementById('library-list')?.dataset.rowsUrl) {
        results.innerHTML = '<div class="search-empty" role="status">正在加载内容…</div>'
        setOpen(true)
        try { await loadLibraryRows() }
        catch {
          if (revision !== searchRevision) return
          results.innerHTML = '<div class="search-empty" role="status">内容加载失败，请重新输入以重试。</div>'
          return
        }
        if (revision !== searchRevision || document.activeElement !== input) return
      }

      const tokens = query.split(/\s+/).filter(Boolean)
      const matches = (index ??= readIndex())
        .filter(item => tokens.every(token => item._hay.includes(token)))
        .sort((a, b) => {
          const titleA = a.title.toLowerCase()
          const titleB = b.title.toLowerCase()
          const scoreA = titleA.startsWith(query) ? 0 : titleA.includes(query) ? 1 : 2
          const scoreB = titleB.startsWith(query) ? 0 : titleB.includes(query) ? 1 : 2
          return scoreA - scoreB || a.title.localeCompare(b.title)
        })

      render(matches)
      setOpen(true)
    }

    input.addEventListener('input', () => search(input.value))
    input.addEventListener('focus', () => { if (input.value) search(input.value) })
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        if (!input.value.trim()) return
        event.preventDefault()
        if (results.classList.contains('hidden')) search(input.value)
        setActive(activeIndex + 1)
      } else if (event.key === 'ArrowUp') {
        if (!input.value.trim()) return
        event.preventDefault()
        setActive(activeIndex - 1)
      } else if (event.key === 'Enter' && activeIndex >= 0 && rendered[activeIndex]) {
        event.preventDefault()
        const target = rendered[activeIndex]
        if (target.externalOnly) window.open(target.target, '_blank', 'noopener')
        else window.location.href = target.target
      } else if (event.key === 'Escape') {
        searchRevision++
        setOpen(false)
      }
    })

    clear.addEventListener('click', () => {
      input.value = ''
      search('')
      input.focus()
    })

    results.addEventListener('pointermove', (event) => {
      if (!(event.target instanceof Element)) return
      const option = event.target.closest('[role="option"]')
      if (!option) return
      const options = [...results.querySelectorAll('[role="option"]')]
      const nextIndex = options.indexOf(option)
      if (nextIndex >= 0 && nextIndex !== activeIndex) setActive(nextIndex)
    })

    root.addEventListener('focusout', () => {
      requestAnimationFrame(() => {
        if (!root.contains(document.activeElement)) setOpen(false)
      })
    })

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target)) setOpen(false)
    })

    document.addEventListener('keydown', (event) => {
      const target = event.target
      const isTyping = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target?.isContentEditable
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault()
        input.focus()
        input.select()
      } else if (event.key === '/' && !isTyping) {
        event.preventDefault()
        input.focus()
      }
    })
  })()
</script>
