---
import EpisodeReadState from '../components/EpisodeReadState.astro'
import { url } from '../lib/url'

interface Props {
  title: string
  description?: string
}
const { title, description = '声笺 Resonote — 把长播客整理成值得翻阅的视觉笔记与长读文章' } = Astro.props
const pathname = Astro.url.pathname
const basePath = import.meta.env.BASE_URL || '/'
const isHome = pathname === basePath || pathname === basePath.replace(/\/$/, '')
const isLibrary = pathname.includes('/library')
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eee8dc" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="声笺 Resonote" href={url('/rss.xml')} />
    <title>{title}</title>
  </head>
  <body class="resonote-shell text-stone-900 antialiased min-h-screen">
    <a class="skip-link" href="#content">跳到主要内容</a>
    <header class="site-header">
      <div class="max-w-6xl mx-auto px-5 md:px-6 h-[68px] flex items-center justify-between">
        <a href={url('/')} class="brand-mark" aria-label="声笺 Resonote 首页">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M7.5 4.5h12l5 5v18h-17z" />
            <path d="M19.5 4.5v5h5M12 20v-5m4 7V12m4 8v-5" />
          </svg>
          <span class="brand-lockup"><strong>声笺</strong><small>RESONOTE</small></span>
        </a>
        <nav class="site-nav text-sm text-stone-600" aria-label="主导航">
          <a href={url('/')} class="nav-link" aria-current={isHome ? 'page' : undefined}>首页</a>
          <a href={url('/library/')} class="nav-link" aria-current={isLibrary ? 'page' : undefined}>内容库</a>
        </nav>
      </div>
    </header>
    <main id="content" class="max-w-6xl mx-auto px-5 md:px-6 py-10 md:py-14">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="max-w-6xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-2">
        <span>声笺 · 余音绕梁，落墨成笺</span>
        <a href={url('/rss.xml')} class="footer-rss" title="RSS 订阅声笺更新">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 11a9 9 0 0 1 9 9" />
            <path d="M4 4a16 16 0 0 1 16 16" />
            <circle cx="5.2" cy="18.8" r="1.7" />
          </svg>
          <span>RSS 订阅</span>
        </a>
        <span>RESONOTE · EDITORIAL ARCHIVE</span>
      </div>
    </footer>
    <EpisodeReadState />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --resonote-ink: #26322f;
    --resonote-muted: #68736f;
    --resonote-paper: #fbf8f1;
    --resonote-canvas: #eee8dc;
    --resonote-line: #d7cec0;
    --resonote-blue: #355f58;
    --resonote-amber: #aa5143;
    --resonote-sage: #829188;
    --resonote-gold: #ad8756;
    --resonote-ink-rgb: 38, 50, 47;
    --resonote-accent-rgb: 53, 95, 88;
    --resonote-seal-rgb: 170, 81, 67;
  }
  html {
    background: var(--resonote-canvas);
    scroll-behavior: smooth;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
  }
  body {
    margin: 0;
    font-feature-settings: "cv11", "ss01";
  }
  /* Author display rules (e.g. scoped .library-row { display: grid }) otherwise
     defeat the UA [hidden] rule, making filter/progressive-disclosure state
     visually ineffective. */
  [hidden] { display: none !important; }
  .resonote-shell {
    color: var(--resonote-ink);
    background:
      radial-gradient(circle at 86% -6%, rgba(var(--resonote-accent-rgb), 0.12), transparent 34rem),
      radial-gradient(circle at 7% 18%, rgba(var(--resonote-seal-rgb), 0.045), transparent 24rem),
      repeating-linear-gradient(90deg, rgba(var(--resonote-ink-rgb), 0.012) 0 1px, transparent 1px 7px),
      linear-gradient(180deg, #f8f4ec 0, var(--resonote-canvas) 34rem);
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid rgba(var(--resonote-ink-rgb), 0.09);
    background: rgba(251, 248, 241, 0.87);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .brand-mark {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 11px;
    color: var(--resonote-ink);
    font-family: Iowan Old Style, Baskerville, "Songti SC", STSong, Georgia, serif;
    font-size: 1.35rem;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .brand-mark svg {
    width: 31px;
    height: 31px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.55;
    stroke-linecap: round;
  }
  .brand-mark svg path:last-child { stroke: var(--resonote-amber); stroke-width: 1.8; }
  .brand-lockup { display: grid; gap: 1px; line-height: 1; }
  .brand-lockup strong { font-weight: 700; }
  .brand-lockup small {
    color: #7b817c;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.46rem;
    font-weight: 750;
    letter-spacing: 0.19em;
  }
  .nav-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0 12px;
    position: relative;
    color: #5f6b67;
    font-weight: 600;
    text-decoration: none;
    transition: color 180ms ease;
  }
  .nav-link::after {
    position: absolute;
    right: 12px;
    bottom: 5px;
    left: 12px;
    height: 2px;
    content: "";
    background: var(--resonote-amber);
    opacity: 0;
    transform: scaleX(0.35);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .nav-link:hover { color: var(--resonote-blue); }
  .nav-link[aria-current="page"] {
    color: var(--resonote-ink);
  }
  .nav-link[aria-current="page"]::after { opacity: 1; transform: scaleX(1); }
  .site-nav { display: flex; align-items: center; gap: 2px; }
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid rgba(var(--resonote-ink-rgb), 0.1);
    color: #737d78;
    font-size: 0.75rem;
    background: rgba(251, 248, 241, 0.58);
  }
  .footer-rss {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 6px;
    color: #737d78;
    text-decoration: none;
    transition: color 180ms ease;
  }
  .footer-rss:hover { color: var(--resonote-amber); }
  .footer-rss svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 8px;
    left: 8px;
    padding: 8px 12px;
    border-radius: 8px;
    color: white;
    background: var(--resonote-ink);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-220%);
  }
  .skip-link:focus { opacity: 1; pointer-events: auto; transform: translateY(0); }
  :where(a, button, input, select):focus-visible {
    outline: 3px solid rgba(var(--resonote-accent-rgb), 0.28);
    outline-offset: 3px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 520px) {
    .brand-mark { gap: 7px; font-size: 1.25rem; }
    .brand-mark svg { width: 27px; height: 27px; }
    .nav-link { padding-inline: 9px; font-size: 0.78rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition-duration: 0.01ms !important; }
  }
</style>
