---
import Base from '../../layouts/Base.astro'
import EpisodeCard from '../../components/EpisodeCard.astro'
import FormatTabs from '../../components/FormatTabs.astro'
import { loadEpisodes, collectTags, sortEpisodesByPublishedDesc } from '../../lib/data'
import { url } from '../../lib/url'

export async function getStaticPaths() {
  const episodes = loadEpisodes()
  const tags = collectTags(episodes)
  return tags.map(({ tag }) => ({ params: { tag }, props: { tag } }))
}

const { tag } = Astro.props
const episodes = sortEpisodesByPublishedDesc(loadEpisodes().filter(e => (e.tags || []).includes(tag)))
const generated = episodes.filter(e => e.status === 'generated')
const pending = episodes.filter(e => e.status !== 'generated' && e.status !== 'failed')
const failed = episodes.filter(e => e.status === 'failed')
---

<Base title={`#${tag} · 声笺 Resonote`} description={`浏览声笺中与 ${tag} 相关的播客内容。`}>
  <a href={url('/')} class="back-link">
    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 5 7.5 10l5 5M8 10h7" /></svg>
    返回首页
  </a>

  <header class="collection-header">
    <div class="collection-kicker">RESONOTE · TOPIC</div>
    <h1><span>#</span>{tag}</h1>
    <p>{episodes.length} 集相关内容，其中 {generated.length} 集已有视觉笔记。</p>
  </header>

  {generated.length > 0 && (
    <div id="episode-grid">
      <FormatTabs />
      <section class="mb-12" data-format-section>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-500 mb-4">已生成</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {generated.map(ep => <EpisodeCard episode={ep} />)}
        </div>
      </section>
    </div>
  )}

  {pending.length > 0 && (
    <section>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-500 mb-4">待处理</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {pending.map(ep => <EpisodeCard episode={ep} />)}
      </div>
    </section>
  )}

  {failed.length > 0 && (
    <section>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-red-500 mb-4">需要排障</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {failed.map(ep => <EpisodeCard episode={ep} />)}
      </div>
    </section>
  )}
</Base>

<style>
  .back-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    color: #69767d;
    font-size: 0.74rem;
    font-weight: 700;
    text-decoration: none;
  }
  .back-link:hover { color: var(--resonote-blue); }
  .back-link svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .collection-header { margin-bottom: 34px; padding: 28px 0 30px; border-bottom: 1px solid rgba(var(--resonote-ink-rgb), 0.11); }
  .collection-kicker { margin-bottom: 9px; color: var(--resonote-blue); font-size: 0.67rem; font-weight: 800; letter-spacing: 0.18em; }
  .collection-header h1 {
    margin: 0;
    color: var(--resonote-ink);
    font-family: Iowan Old Style, Baskerville, "Songti SC", STSong, Georgia, serif;
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }
  .collection-header h1 span { margin-right: 5px; color: var(--resonote-amber); }
  .collection-header p { margin: 13px 0 0; color: #65736d; font-size: 0.84rem; }
</style>
