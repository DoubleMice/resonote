---
import Base from '../layouts/Base.astro'
import EpisodeCard from '../components/EpisodeCard.astro'
import FeaturedNote from '../components/FeaturedNote.astro'
import SearchBox from '../components/SearchBox.astro'
import DiscoveryTabs from '../components/DiscoveryTabs.astro'
import { loadEpisodes, loadSourcesWithFallbacks, collectTags, CATEGORIES } from '../lib/data'
import { url } from '../lib/url'

const CATEGORY_NOTES = {
  'ai-tech': '模型、产品与技术前沿',
  'mind-body': '认知、健康与人的内在世界',
  science: '科学发现与解释世界的方法',
  business: '公司、增长与职业选择',
  culture: '历史、社会与文化观察',
} as const

const episodes = loadEpisodes()
const sources = loadSourcesWithFallbacks(episodes)
const tags = collectTags(episodes)
const generated = episodes.filter(episode => episode.status === 'generated')
const articles = episodes.filter(episode => episode.article_path)
const sortedGenerated = [...generated].sort((a, b) =>
  (b.generated_sort ?? 0) - (a.generated_sort ?? 0)
  || (b.published ?? '').localeCompare(a.published ?? ''))
const latest = sortedGenerated.slice(0, 7)
const featured = latest[0]
const recent = latest.slice(1)

const categoryIndex = CATEGORIES.map(category => {
  const all = sortedGenerated.filter(episode => episode.category === category.id)
  return {
    ...category,
    total: all.length,
    description: CATEGORY_NOTES[category.id],
    featured: all[0],
  }
}).filter(category => category.total > 0)

const sourcesWithCount = sources
  .map(source => ({
    ...source,
    count: episodes.filter(episode => episode.source === source.id).length,
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
---

<Base title="声笺 · Resonote" description="让声音有余韵，让思想落成页。把长播客整理成值得翻阅的视觉笔记与长读文章。">
  <section class:list={['hero-grid', { 'hero-grid-single': !featured }]} aria-labelledby="home-title">
    <div class="hero-copy">
      <div class="section-kicker">声笺 · RESONOTE</div>
      <h1 id="home-title" class="hero-title">
        让声音有余韵，<br /><span>让思想落成页</span>
      </h1>
      <p class="hero-lede">
        从漫长对谈中提炼叙事、论点与原话，整理成有手绘图的视觉笔记和适合长读的中文文章。
        用约 15 分钟，留下一条值得反复翻阅的思想脉络。
      </p>

      <div class="hero-search">
        <SearchBox episodes={episodes} />
      </div>

      <div class="hero-foot">
        <dl class="hero-stats" aria-label="内容统计">
          <div><dt>{generated.length}</dt><dd>份视觉笔记</dd></div>
          <div><dt>{articles.length}</dt><dd>篇长读文章</dd></div>
          <div><dt>{sources.length}</dt><dd>档播客来源</dd></div>
        </dl>
        <a class="hero-library-link" href={url('/library/')}>
          翻阅全部内容
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10m-4-4 4 4-4 4" /></svg>
        </a>
      </div>
    </div>

    {featured && <FeaturedNote episode={featured} />}
  </section>

  <DiscoveryTabs tags={tags} sources={sourcesWithCount} />

  {recent.length > 0 && (
    <section class="content-section mb-16" aria-labelledby="recent-title">
      <div class="section-heading">
        <div>
          <div class="section-overline">RECENT NOTES</div>
          <h2 id="recent-title">近日新笺</h2>
          <p>最近整理完成的视觉笔记与长读文章。</p>
        </div>
        <a href={url('/library/')}>查看内容库 <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recent.map(episode => <EpisodeCard episode={episode} />)}
      </div>
    </section>
  )}

  {categoryIndex.length > 0 && (
    <section class="content-section mb-16" aria-labelledby="theme-title">
      <div class="section-heading">
        <div>
          <div class="section-overline">THEMATIC INDEX</div>
          <h2 id="theme-title">主题索引</h2>
          <p>按关心的方向进入档案，快速找到一组相互照见的声音。</p>
        </div>
      </div>

      <div class="theme-index">
        {categoryIndex.map((category, index) => (
          <a
            class="theme-card"
            href={`${url('/library/')}?category=${category.id}`}
            aria-label={`${category.label}，${category.total} 集内容`}
          >
            <div class="theme-card-top">
              <span class="theme-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="theme-count">{category.total} 集</span>
            </div>
            <h3>{category.label}</h3>
            <p>{category.description}</p>
            {category.featured && (
              <div class="theme-latest">
                <span>最近收录</span>
                <strong>{category.featured.title}</strong>
              </div>
            )}
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10m-4-4 4 4-4 4" /></svg>
          </a>
        ))}
      </div>
    </section>
  )}

  <aside class="archive-cta" aria-labelledby="archive-title">
    <div>
      <div class="section-overline">THE COMPLETE ARCHIVE</div>
      <h2 id="archive-title">还有更多声音，已经落成书页</h2>
      <p>{episodes.length} 集播客，沿着来源、主题、标签与阅读状态继续翻阅。</p>
    </div>
    <a href={url('/library/')}>
      进入完整内容库
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10m-4-4 4 4-4 4" /></svg>
    </a>
  </aside>
</Base>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(390px, 0.92fr);
    align-items: center;
    gap: clamp(38px, 6vw, 76px);
    margin-bottom: clamp(4rem, 8vw, 6.5rem);
    padding: clamp(0.5rem, 2vw, 1.5rem) 0;
  }
  .hero-grid-single { grid-template-columns: minmax(0, 740px); }
  .hero-copy { min-width: 0; }
  .section-kicker,
  .section-overline {
    color: var(--pd-blue);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }
  .section-kicker { margin-bottom: 14px; }
  .hero-title {
    margin: 0;
    color: var(--pd-ink);
    font-family: Iowan Old Style, Baskerville, "Songti SC", STSong, Georgia, serif;
    font-size: clamp(2.7rem, 5.5vw, 4.65rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  .hero-title span { color: var(--pd-blue); }
  .hero-lede {
    max-width: 41rem;
    margin: 20px 0 0;
    color: #5f6c67;
    font-size: clamp(0.92rem, 1.5vw, 1.04rem);
    line-height: 1.82;
  }
  .hero-search { margin-top: 25px; }
  .hero-search :global(.search-shell) { max-width: none; margin-bottom: 0; }
  .hero-foot { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 17px; }
  .hero-stats { display: flex; gap: 0; margin: 0; }
  .hero-stats > div { display: flex; align-items: baseline; gap: 5px; padding-right: 13px; }
  .hero-stats > div + div { padding-left: 13px; border-left: 1px solid rgba(var(--pd-ink-rgb), 0.12); }
  .hero-stats dt {
    color: var(--pd-ink);
    font-family: Iowan Old Style, Baskerville, Georgia, serif;
    font-size: 1.2rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .hero-stats dd { margin: 0; color: #7a8580; font-size: 0.62rem; white-space: nowrap; }
  .hero-library-link {
    display: inline-flex;
    min-height: 44px;
    flex: 0 0 auto;
    align-items: center;
    gap: 6px;
    color: var(--pd-blue);
    font-size: 0.7rem;
    font-weight: 760;
    text-decoration: none;
  }
  .hero-library-link svg,
  .archive-cta svg,
  .theme-card > svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 180ms ease;
  }
  .hero-library-link:hover svg,
  .archive-cta a:hover svg { transform: translateX(3px); }
  .section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 22px; }
  .section-heading h2,
  .archive-cta h2 {
    margin: 5px 0 0;
    color: var(--pd-ink);
    font-family: Iowan Old Style, Baskerville, "Songti SC", STSong, Georgia, serif;
    font-size: clamp(1.8rem, 3.5vw, 2.45rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .section-heading p,
  .archive-cta p { margin: 8px 0 0; color: #6f7b76; font-size: 0.76rem; line-height: 1.65; }
  .section-heading > a {
    display: inline-flex;
    min-height: 44px;
    flex: 0 0 auto;
    align-items: center;
    gap: 5px;
    color: var(--pd-blue);
    font-size: 0.74rem;
    font-weight: 750;
    text-decoration: none;
  }
  .theme-index { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 10px; }
  .theme-card {
    position: relative;
    display: flex;
    min-height: 250px;
    flex-direction: column;
    padding: 18px 17px;
    overflow: hidden;
    border: 1px solid rgba(var(--pd-ink-rgb), 0.1);
    border-radius: 3px 16px 16px 3px;
    color: var(--pd-ink);
    background: rgba(251, 248, 241, 0.72);
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }
  .theme-card:hover {
    border-color: rgba(var(--pd-accent-rgb), 0.27);
    background: rgba(255, 253, 248, 0.96);
    box-shadow: 0 15px 34px rgba(var(--pd-ink-rgb), 0.07);
    transform: translateY(-2px);
  }
  .theme-card::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 3px;
    content: "";
    background: var(--pd-amber);
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .theme-card:hover::before { opacity: 0.85; }
  .theme-card-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .theme-number {
    color: var(--pd-amber);
    font-family: Iowan Old Style, Baskerville, Georgia, serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .theme-count { color: #84908a; font-size: 0.61rem; }
  .theme-card h3 {
    margin: 19px 0 0;
    font-family: Iowan Old Style, Baskerville, "Songti SC", STSong, Georgia, serif;
    font-size: 1.12rem;
    line-height: 1.22;
  }
  .theme-card > p { min-height: 2.8em; margin: 7px 0 0; color: #78837e; font-size: 0.67rem; line-height: 1.5; }
  .theme-latest { min-width: 0; margin-top: auto; padding-top: 17px; border-top: 1px solid rgba(var(--pd-ink-rgb), 0.08); }
  .theme-latest span { display: block; margin-bottom: 5px; color: #929a96; font-size: 0.56rem; }
  .theme-latest strong {
    display: -webkit-box;
    overflow: hidden;
    color: #56635e;
    font-size: 0.67rem;
    font-weight: 650;
    line-height: 1.48;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .theme-card > svg { position: absolute; right: 14px; bottom: 14px; color: var(--pd-blue); opacity: 0; }
  .theme-card:hover > svg { opacity: 1; transform: translateX(2px); }
  .archive-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: clamp(28px, 5vw, 48px);
    border: 1px solid rgba(var(--pd-ink-rgb), 0.12);
    border-left: 4px solid var(--pd-amber);
    border-radius: 4px 22px 22px 4px;
    background:
      radial-gradient(circle at 88% 10%, rgba(var(--pd-seal-rgb), 0.08), transparent 16rem),
      rgba(251, 248, 241, 0.82);
    box-shadow: 0 16px 42px rgba(var(--pd-ink-rgb), 0.055);
  }
  .archive-cta > div { max-width: 44rem; }
  .archive-cta h2 { font-size: clamp(1.55rem, 3vw, 2.15rem); }
  .archive-cta > a {
    display: inline-flex;
    min-height: 48px;
    flex: 0 0 auto;
    align-items: center;
    gap: 8px;
    padding: 0 18px;
    border-radius: 3px 13px 13px 3px;
    color: #fffaf2;
    background: var(--pd-ink);
    font-size: 0.75rem;
    font-weight: 760;
    text-decoration: none;
  }
  .archive-cta > a:hover { background: var(--pd-blue); }
  @media (max-width: 980px) {
    .hero-grid { grid-template-columns: 1fr; align-items: start; }
    .hero-copy { max-width: 760px; }
    .hero-grid :global(.featured-note) { max-width: 690px; }
    .theme-index { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 680px) {
    .hero-grid { gap: 36px; margin-bottom: 4.5rem; padding-top: 0; }
    .hero-title { font-size: clamp(2.45rem, 12.5vw, 3.45rem); }
    .hero-foot { align-items: flex-start; flex-direction: column; gap: 5px; }
    .hero-library-link { margin-left: -2px; }
    .theme-index { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .archive-cta { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 480px) {
    .hero-stats { width: 100%; }
    .hero-stats > div { flex: 1 1 0; align-items: flex-start; flex-direction: column; gap: 1px; padding-right: 9px; }
    .hero-stats > div + div { padding-left: 9px; }
    .hero-stats dd { white-space: normal; }
    .section-heading { align-items: flex-start; }
    .section-heading > a { white-space: nowrap; }
    .theme-index { grid-template-columns: 1fr; }
    .theme-card { min-height: 218px; }
    .archive-cta { padding: 26px 22px; }
    .archive-cta > a { width: 100%; }
  }
</style>
