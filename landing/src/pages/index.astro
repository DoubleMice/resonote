---
import Base from '../layouts/Base.astro'
import EpisodeCard from '../components/EpisodeCard.astro'
import EpisodeRow from '../components/EpisodeRow.astro'
import FeaturedNote from '../components/FeaturedNote.astro'
import SearchBox from '../components/SearchBox.astro'
import DiscoveryTabs from '../components/DiscoveryTabs.astro'
import LibraryFilters from '../components/LibraryFilters.astro'
import {
  loadEpisodes, loadSourcesWithFallbacks, collectTags,
  sortEpisodesByPublishedDesc, sortEpisodesForLibrary,
} from '../lib/data'
import { url } from '../lib/url'

const episodes = loadEpisodes()
const sources = loadSourcesWithFallbacks(episodes)
const tags = collectTags(episodes)
const generated = episodes.filter(episode => episode.status === 'generated')
const articles = episodes.filter(episode => episode.article_path)
const sortedGenerated = sortEpisodesByPublishedDesc(generated)
const libraryEpisodes = sortEpisodesForLibrary(episodes)
const latest = sortedGenerated.slice(0, 7)
const featured = latest[0]
const recent = latest.slice(1)

const sourcesWithCount = sources
  .map(source => ({
    ...source,
    count: episodes.filter(episode => episode.source === source.id).length,
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
---

<Base title="声笺 · Resonote" description="余音绕梁，落墨成笺。把长播客整理成值得翻阅的视觉笔记与长读文章。">
  <section class:list={['hero-grid', { 'hero-grid-single': !featured }]} aria-labelledby="home-title">
    <div class="hero-copy">
      <div class="section-kicker">声笺 · RESONOTE</div>
      <h1 id="home-title" class="hero-title">
        余音绕梁，<br /><span>落墨成笺</span>
      </h1>
      <p class="hero-lede">
        长谈既尽，余韵未散。从两三小时的对谈中撷取叙事、论点与原话，佐以手绘图，
        整理成可翻阅的视觉笔记与中文长文。约一刻钟的翻阅，留住两三个小时的深思。
      </p>

      <div class="hero-search">
        <SearchBox />
      </div>

      <div class="hero-foot">
        <dl class="hero-stats" aria-label="内容统计">
          <div><dt>{generated.length}</dt><dd>份视觉笔记</dd></div>
          <div><dt>{articles.length}</dt><dd>篇长读文章</dd></div>
          <div><dt>{sources.length}</dt><dd>档播客来源</dd></div>
        </dl>
        <a class="hero-library-link" href={url('/library/')}>
          翻阅全部内容
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10m-4-4 4 4-4 4" /></svg>
        </a>
      </div>
    </div>

    {featured && <FeaturedNote episode={featured} />}
  </section>

  <DiscoveryTabs tags={tags} sources={sourcesWithCount} />

  {recent.length > 0 && (
    <section class="content-section mb-16" aria-labelledby="recent-title">
      <div class="section-heading">
        <div>
          <div class="section-overline">RECENT NOTES</div>
          <h2 id="recent-title">近日新笺</h2>
          <p>最近发布的对谈，已整理成视觉笔记与长读文章。</p>
        </div>
        <a href={url('/library/')}>查看内容库 <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recent.map(episode => <EpisodeCard episode={episode} />)}
      </div>
    </section>
  )}

  <section class="content-section home-library mb-16" aria-labelledby="home-library-title">
    <div class="section-heading">
      <div>
        <div class="section-overline">THE COMPLETE ARCHIVE</div>
        <h2 id="home-library-title">全部声笺</h2>
        <p>完整收录既有播客内容；可按形式、主题、关键词和阅读状态筛选。</p>
      </div>
      <a href={url('/library/')}>独立打开内容库 <span aria-hidden="true">→</span></a>
    </div>

    <LibraryFilters />
    <div class="home-library-list" id="library-list">
      {libraryEpisodes.map((episode, index) => <EpisodeRow episode={episode} initialHidden={index >= 36} />)}
    </div>
  </section>

  <aside class="archive-cta" aria-labelledby="archive-title">
    <div>
      <div class="section-overline">THE COMPLETE ARCHIVE</div>
      <h2 id="archive-title">还有更多声音，已经落成书页</h2>
      <p>{episodes.length} 集播客，沿着来源、主题、标签与阅读状态继续翻阅。</p>
    </div>
    <a href={url('/library/')}>
      进入完整内容库
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10m-4-4 4 4-4 4" /></svg>
    </a>
  </aside>
</Base>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(390px, 0.92fr);
    align-items: center;
    gap: clamp(38px, 6vw, 76px);
    margin-bottom: clamp(4rem, 8vw, 6.5rem);
    padding: clamp(0.5rem, 2vw, 1.5rem) 0;
  }
  .hero-grid-single { grid-template-columns: minmax(0, 740px); }
  .hero-copy { min-width: 0; }
  .section-kicker,
  .section-overline {
    color: var(--resonote-blue);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }
  .section-kicker { margin-bottom: 14px; }
  .hero-title {
    margin: 0;
    color: var(--resonote-ink);
    font-family: Iowan Old Style, Baskerville, "Songti SC", STSong, Georgia, serif;
    font-size: clamp(2.7rem, 5.5vw, 4.65rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  .hero-title span { color: var(--resonote-blue); }
  .hero-lede {
    max-width: 41rem;
    margin: 20px 0 0;
    color: #5f6c67;
    font-size: clamp(0.92rem, 1.5vw, 1.04rem);
    line-height: 1.82;
  }
  .hero-search { margin-top: 25px; }
  .hero-search :global(.search-shell) { max-width: none; margin-bottom: 0; }
  .hero-foot { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 17px; }
  .hero-stats { display: flex; gap: 0; margin: 0; }
  .hero-stats > div { display: flex; align-items: baseline; gap: 5px; padding-right: 13px; }
  .hero-stats > div + div { padding-left: 13px; border-left: 1px solid rgba(var(--resonote-ink-rgb), 0.12); }
  .hero-stats dt {
    color: var(--resonote-ink);
    font-family: Iowan Old Style, Baskerville, Georgia, serif;
    font-size: 1.2rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .hero-stats dd { margin: 0; color: #7a8580; font-size: 0.62rem; white-space: nowrap; }
  .hero-library-link {
    display: inline-flex;
    min-height: 44px;
    flex: 0 0 auto;
    align-items: center;
    gap: 6px;
    color: var(--resonote-blue);
    font-size: 0.7rem;
    font-weight: 760;
    text-decoration: none;
  }
  .hero-library-link svg,
  .archive-cta svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 180ms ease;
  }
  .hero-library-link:hover svg,
  .archive-cta a:hover svg { transform: translateX(3px); }
  .section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 22px; }
  .section-heading h2,
  .archive-cta h2 {
    margin: 5px 0 0;
    color: var(--resonote-ink);
    font-family: Iowan Old Style, Baskerville, "Songti SC", STSong, Georgia, serif;
    font-size: clamp(1.8rem, 3.5vw, 2.45rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .section-heading p,
  .archive-cta p { margin: 8px 0 0; color: #6f7b76; font-size: 0.76rem; line-height: 1.65; }
  .section-heading > a {
    display: inline-flex;
    min-height: 44px;
    flex: 0 0 auto;
    align-items: center;
    gap: 5px;
    color: var(--resonote-blue);
    font-size: 0.74rem;
    font-weight: 750;
    text-decoration: none;
  }
  .home-library-list { display: grid; gap: 11px; }
  :global(.js .home-library-list .library-row[data-initial-hidden="true"]) { display: none; }
  .archive-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: clamp(28px, 5vw, 48px);
    border: 1px solid rgba(var(--resonote-ink-rgb), 0.12);
    border-left: 4px solid var(--resonote-amber);
    border-radius: 4px 22px 22px 4px;
    background:
      radial-gradient(circle at 88% 10%, rgba(var(--resonote-seal-rgb), 0.08), transparent 16rem),
      rgba(251, 248, 241, 0.82);
    box-shadow: 0 16px 42px rgba(var(--resonote-ink-rgb), 0.055);
  }
  .archive-cta > div { max-width: 44rem; }
  .archive-cta h2 { font-size: clamp(1.55rem, 3vw, 2.15rem); }
  .archive-cta > a {
    display: inline-flex;
    min-height: 48px;
    flex: 0 0 auto;
    align-items: center;
    gap: 8px;
    padding: 0 18px;
    border-radius: 3px 13px 13px 3px;
    color: #fffaf2;
    background: var(--resonote-ink);
    font-size: 0.75rem;
    font-weight: 760;
    text-decoration: none;
  }
  .archive-cta > a:hover { background: var(--resonote-blue); }
  @media (max-width: 980px) {
    .hero-grid { grid-template-columns: 1fr; align-items: start; }
    .hero-copy { max-width: 760px; }
    .hero-grid :global(.featured-note) { max-width: 690px; }
  }
  @media (max-width: 680px) {
    .hero-grid { gap: 36px; margin-bottom: 4.5rem; padding-top: 0; }
    .hero-title { font-size: clamp(2.45rem, 12.5vw, 3.45rem); }
    .hero-foot { align-items: flex-start; flex-direction: column; gap: 5px; }
    .hero-library-link { margin-left: -2px; }
    .archive-cta { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 480px) {
    .hero-stats { width: 100%; }
    .hero-stats > div { flex: 1 1 0; align-items: flex-start; flex-direction: column; gap: 1px; padding-right: 9px; }
    .hero-stats > div + div { padding-left: 9px; }
    .hero-stats dd { white-space: normal; }
    .section-heading { align-items: flex-start; }
    .section-heading > a { white-space: nowrap; }
    .archive-cta { padding: 26px 22px; }
    .archive-cta > a { width: 100%; }
  }
</style>
