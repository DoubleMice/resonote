{
  "name": "resonote",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "description": "Resonote podcast visual notes and long-form article pipeline",
  "scripts": {
    "discover": "tsx scripts/discover.ts",
    "generate": "tsx scripts/run-plan.ts",
    "cache:refresh": "tsx scripts/refresh-cache.ts",
    "plan": "tsx scripts/plan.ts",
    "plan:run": "tsx scripts/run-plan.ts",
    "analyze": "tsx scripts/analyze-scan.ts",
    "build": "tsx scripts/build-all.ts",
    "audit:brand": "tsx scripts/audit-brand.ts",
    "audit:home": "tsx scripts/audit-home.ts",
    "audit:layout": "tsx scripts/audit-layout.ts",
    "validate:artifacts": "tsx scripts/validate-artifacts.ts",
    "normalize:meta": "tsx scripts/normalize-meta.ts",
    "e2e:transcription": "tsx scripts/e2e-transcription.ts",
    "test": "tsx --test scripts/lib/*.test.ts landing/src/lib/*.test.ts",
    "test:mimo": "tsx --test scripts/lib/mimo.test.ts",
    "test:workspace": "tsx --test scripts/lib/episode-workspace.test.ts",
    "test:sources": "tsx --test scripts/lib/source-filter.test.ts",
    "test:yaml": "tsx --test scripts/lib/yaml-repair.test.ts",
    "test:article-theme": "tsx --test scripts/lib/article-theme.test.ts",
    "verify:routing": "tsx scripts/verify-slide-routing.ts",
    "preview": "npx --yes serve@14.2.6 dist -p 4173",
    "dev:landing": "echo 'TODO: P4'",
    "dev:episode": "tsx scripts/dev-episode.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright-chromium": "^1.61.0",
    "tsx": "^4.19.0",
    "vite": "8.1.5",
    "yaml": "^2.5.0"
  },
  "dependencies": {
    "@slidev/cli": "52.18.0",
    "@slidev/parser": "52.18.0",
    "slidev-addon-excalidraw": "^1.1.1",
    "slidev-theme-academic": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "@slidev/cli": "52.18.0"
    },
    "patchedDependencies": {
      "@slidev/parser@52.18.0": "patches/@slidev__parser@52.18.0.patch"
    }
  }
}
